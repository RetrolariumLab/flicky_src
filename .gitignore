# Reference ROM and extracted data.
# The original cartridge dump and everything sliced out of it are never
# tracked. Run 'make split' to regenerate them from a legally obtained ROM.
*.bin
data/**/*.bin

# Build artifacts
build/
fbuilt.bin
flicky.map
flicky.asm
*.p
*.lst
temp.asm
tools/*.exe
tools/*.o

# Emulator evidence and analysis output (regenerated, never authoritative)
reference/
diffs/
logs/
reports/
workflow/
test_screenshots/
analysis_report*
analysis_results.csv
unnamed_procedures.txt
rename_log.txt
batch_extract.txt
batch_analysis.csv
batch_renames.csv
flicky_backup_*.s

# Local emulator checkout (see GENS_DIR in the Makefile)
gens_automation/
Gens.cfg
language.dat

# IDA
*.idb
*.id0
*.id1
*.nam
*.til

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Scratch
tmp/
tmpclaude*
*.lnk

# Stray AS outputs if the assembler is invoked by hand from bin/
bin/.p
bin/.lst
