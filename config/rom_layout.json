{
  "schema_version": 1,
  "target": {
    "platform": "Sega Mega Drive / Genesis",
    "cpu": "Motorola 68000",
    "cartridge_size": 131072,
    "translation_unit": "single",
    "entrypoint": "flicky.s",
    "entrypoint_note": "AS assembles one translation unit, so there is no linker and no linker script. The include order in flicky.s is the ROM layout: moving an include moves code in the output."
  },
  "memory_regions": [
    {
      "id": "rom",
      "start": "0x000000",
      "end": "0x01FFFF",
      "size": 131072,
      "access": "read-only",
      "owner": "flicky.s"
    },
    {
      "id": "work_ram",
      "start": "0xFF0000",
      "end": "0xFFFFFF",
      "size": 65536,
      "access": "read-write",
      "owner": "src/memory/ram.inc",
      "note": "Mirrored throughout $FF0000-$FFFFFF"
    },
    {
      "id": "z80_ram",
      "start": "0xA00000",
      "end": "0xA01FFF",
      "size": 8192,
      "access": "read-write via bus request",
      "owner": "src/memory/hardware.inc"
    },
    {
      "id": "io_and_vdp",
      "start": "0xA10000",
      "end": "0xC0001F",
      "access": "memory-mapped registers",
      "owner": "src/memory/hardware.inc",
      "note": "Addresses are named there; make lint rejects raw ones elsewhere"
    }
  ],
  "rom_image": {
    "size": 131072,
    "padding_byte": "0xFF",
    "padding_tool": "p2bin -p=FF",
    "vector_table": {
      "start": "0x000000",
      "end": "0x0000FF",
      "symbol": "Sys_VectorTable",
      "owner": "src/system/vectors_and_header.s",
      "note": "64 longs; entry 1 holds the initial PC and points at EntryPoint"
    },
    "header": {
      "start": "0x000100",
      "end": "0x0001FF",
      "symbol": "CopyRights",
      "owner": "src/system/vectors_and_header.s"
    },
    "gaps": [
      {
        "start": "0x01B9A0",
        "end": "0x01FFFE",
        "size": 18015,
        "filled_by": "p2bin -p=FF",
        "note": "Not the tail of the image: RomEndData emits $FF at 0x01FFFF, so this is a gap the converter fills, and a p2bin default of $00 would corrupt every byte of it"
      }
    ],
    "landmarks": [
      {
        "symbol": "Sys_VectorTable",
        "address": "0x000000",
        "role": "Exception vector table"
      },
      {
        "symbol": "CopyRights",
        "address": "0x000100",
        "role": "Start of the cartridge header"
      },
      {
        "symbol": "Checksum",
        "address": "0x00018E",
        "role": "Header checksum word, verified at boot by src/system/boot.s"
      },
      {
        "symbol": "RomStart",
        "address": "0x0001A0",
        "role": "Declared ROM start"
      },
      {
        "symbol": "RomEnd",
        "address": "0x0001A4",
        "role": "Declared ROM end, points at RomEndData"
      },
      {
        "symbol": "ErrorTrap",
        "address": "0x000200",
        "role": "Unhandled exception halt"
      },
      {
        "symbol": "EntryPoint",
        "address": "0x000206",
        "role": "Reset entry"
      },
      {
        "symbol": "Sys_GameEntryPoint",
        "address": "0x010000",
        "role": "Game entry; fixed, because data/sound/z80_part2.bin hard-codes pointers to it (SND-001)"
      },
      {
        "symbol": "RomEndData",
        "address": "0x01FFFF",
        "role": "Last byte of the image"
      }
    ]
  },
  "shared_definitions": [
