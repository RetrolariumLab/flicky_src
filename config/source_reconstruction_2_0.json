  "layout_deviations": [
    {
      "rule_id": "canonical-entrypoint-extension",
      "actual_path": "src/main.s",
      "reason": "The established AS 68000 translation-unit convention uses .s; standalone Z80 translation units use .asm.",
      "equivalent_control": "The manifest names src/main.s, config/linker/rom_layout.json owns its include order, and make verify-layout checks that order against the built image."
    },
    {
      "rule_id": "audio-directory-name",
      "actual_path": "src/sound/",
      "reason": "The project uses the Mega Drive-facing term sound for the 68000 host, Z80 driver, music, and SFX ownership boundary.",
      "equivalent_control": "All sound source is contained under src/sound and both Z80 translation units have byte-identity gates."
    },
    {
      "rule_id": "private-extracted-data-directory",
      "actual_path": "data/",
      "reason": "The preserved 1.0 workflow extracts private cartridge segments into data/ rather than assets/generated/.",
      "equivalent_control": "The directory is ignored, assets/manifest.json owns every range and hash, make check-assets verifies it, and release-audit checks reachable history for payloads."
    },
    {
      "rule_id": "additional-make-workflow-fragment",
      "actual_path": "mk/workflow.mk",
      "reason": "The repository retains a distinct reverse-engineering workflow in addition to build, validation, runtime, and authoring.",
      "equivalent_control": "The root Makefile includes the fragment explicitly and tests collect the public Make interface across all fragments."
    }
  ],
