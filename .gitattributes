# Normalize line endings: store LF in the repo and check out LF everywhere,
# so editors that save CRLF on Windows no longer produce whole-file diffs.
* text=auto eol=lf

# Text sources (explicit for clarity; covered by the rule above)
*.s          text eol=lf
*.asm        text eol=lf
*.inc        text eol=lf
*.c          text eol=lf
*.h          text eol=lf
*.py         text eol=lf
*.lua        text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.json       text eol=lf
*.csv        text eol=lf
*.cfg        text eol=lf
*.lst        text eol=lf
*.map        text eol=lf
Makefile     text eol=lf
.gitignore   text eol=lf
.editorconfig text eol=lf

# Binary / toolchain artifacts -- git must never touch these
*.exe        binary
*.msg        binary
*.gmv        binary
*.bin        binary
*.p          binary
*.png        binary
*.gif        binary
*.genstate   binary
*.btrc       binary
*.idb        binary
*.lnk        binary
